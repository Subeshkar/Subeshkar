# ---------- App ----------
# Your public app address, no slash at the end (Railway gives you this)
BASE_URL=https://your-app.up.railway.app
# Password for the /dashboard page
ADMIN_PASSWORD=choose-a-strong-password
# Any long random text (used to sign Google connect links)
SESSION_SECRET=paste-a-long-random-string-here
# Where the database file lives. On Railway, mount a Volume at /data and keep this.
DATA_DIR=/data
# Optional: only these WhatsApp numbers can use Dioma (country code, no +, comma separated)
ALLOWED_NUMBERS=9715XXXXXXXX
# Default time zone and morning brief time for new users
DEFAULT_TIMEZONE=Asia/Dubai
DEFAULT_BRIEF_TIME=07:00

# ---------- Claude (Anthropic Console -> API keys) ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- WhatsApp (Meta for Developers -> your app -> WhatsApp -> API Setup) ----------
WA_TOKEN=EAAG...
WA_PHONE_NUMBER_ID=123456789012345
# You invent this; paste the same text into Meta's webhook "Verify token" box
WA_VERIFY_TOKEN=dioma-verify-123
# App settings -> Basic -> App secret (checks that messages really come from Meta)
WA_APP_SECRET=
# Use the latest version shown in your Meta dashboard
WA_API_VERSION=v23.0
# Optional: an approved message template used for briefs/reminders when the user
# hasn't messaged in the last 24 hours (body must contain one variable {{1}})
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en
# Optional: the Dioma WhatsApp number shown on the landing page (country code, no +)
DIOMA_DISPLAY_NUMBER=

# ---------- Google (Google Cloud Console -> Credentials -> OAuth client ID, Web) ----------
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
